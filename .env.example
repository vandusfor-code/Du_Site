# Generar con: npx auth secret  (o cualquier cadena aleatoria larga)
AUTH_SECRET=

# Credenciales de la cuenta de servicio de Google (Google Cloud Console > IAM > Cuentas de servicio)
GOOGLE_SERVICE_ACCOUNT_EMAIL=nombre@proyecto.iam.gserviceaccount.com
# Pega la clave privada completa entre comillas, con \n en vez de saltos de línea reales
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ID de la hoja de cálculo que contiene la pestaña "Usuarios"
# (compartir esa hoja con el correo de la cuenta de servicio, como Editor)
SHEET_ID_USUARIOS=

# ID de la hoja de cálculo del módulo Métricas (pestañas: TO, Desempeño,
# Consolidado, Historial_bonos, Compromisos). Compartirla también con la
# cuenta de servicio como Editor.
SHEET_ID_METRICAS=

# ID de la hoja de cálculo del módulo PQRSF DATA (pestañas: DATA, CASOS,
# GENERAL, Registros). Compartirla también con la cuenta de servicio como
# Editor.
SHEET_ID_PQRSF_DATA=

# API Key de OpenAI, usada por el módulo PQRSF DATA para clasificar/responder
# consultas con IA (https://platform.openai.com/api-keys)
OPENAI_API_KEY=

# ID de la hoja de cálculo del módulo Radicaciones (pestañas: ASESORES,
# GESTIONES, NOTIFICACIONES, CHAT, Turnos). Compartirla también con la
# cuenta de servicio como Editor.
SHEET_ID_RADICACIONES=

# ID de la hoja de cálculo del módulo Línea Amiga (pestañas: "PQRSF Creados",
# USUARIOS, CHAT, Notificaciones, Turnos). Compartirla también con la
# cuenta de servicio como Editor.
SHEET_ID_LINEA_AMIGA=

# ID de la hoja externa de "inteligencia colectiva" (casos similares) que usa
# el panel de Sugerencias del módulo Línea Amiga. Compartirla también con la
# cuenta de servicio (al menos como Lector).
SHEET_ID_SUGERENCIAS_PQRSF=

# ID de la hoja de cálculo del módulo Quiz / DuAcademy (pestañas: USUARIOS,
# CURSOS, SIMULACIONES, EXAMENES, PROGRESO, BASE-CONOCIMIENTO). Compartirla
# también con la cuenta de servicio como Editor.
SHEET_ID_QUIZ=

# Hojas del módulo Puntos de pago. Compartirlas con la cuenta de servicio
# (al menos como Lector). Si no se definen, se usan los IDs por defecto.
# Puntos-Retiros (Cadena, Departamento, Ciudad, Nombre, Dirección, Horarios):
SHEET_ID_PUNTOS_RETIRO=
# SuperGIROS (DEPARTAMENTO, MUNICIPIO, AGENCIA, DIRECCION):
SHEET_ID_PUNTOS_SUPERGIROS=

# URL pública de tu portal ya desplegado (usada en el botón de los correos de
# recordatorio que envía el panel admin de DuAcademy). Ej: https://tudominio.com
APP_URL=

# Credenciales SMTP para el botón "Notificar a Todos" del panel admin de
# DuAcademy (recordatorio de módulos pendientes por correo). Con Gmail puedes
# usar smtp.gmail.com, puerto 587, y una "contraseña de aplicación" en vez de
# tu contraseña normal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
